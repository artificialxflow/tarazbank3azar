NODE_ENV=production

HOST=0.0.0.0
PORT=3000

DATABASE_URL=postgresql://user:password@localhost:5432/app_db
DIRECT_URL=postgresql://user:password@localhost:5432/app_db

AUTH_SESSION_SECRET=change-me-to-a-long-random-secret-key
AUTH_SESSION_COOKIE=app_session
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_SECURE=true

NEXT_PUBLIC_APP_URL=https://example.com
APP_URL=https://example.com

LOG_LEVEL=info

STORAGE_ROOT=/data

SMS_PROVIDER=generic
SMS_API_KEY=your-sms-api-key
SMS_TEMPLATE_ID=100000

OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_SEND_PER_PHONE_PER_DAY=10

BAAS_API_BASE_URL=https://baas.partner-bank.example/api/v1
BAAS_CLIENT_ID=your-baas-client-id
BAAS_WEBHOOK_SECRET=your-baas-webhook-secret
EXCHANGE_API_KEY=your-exchange-api-key

SKIP_MIGRATE=false
MIGRATE_ONLY=false
